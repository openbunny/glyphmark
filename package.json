{
  "name": "glyphmark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Material Icon Theme glyphs for source-hosting sites, as a Safari web extension.",
  "author": "OpenBunny",
  "homepage": "https://github.com/openbunny/glyphmark",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbunny/glyphmark.git"
  },
  "bugs": {
    "url": "https://github.com/openbunny/glyphmark/issues"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": "1.4.2"
  },
  "scripts": {
    "generate": "bun src/generate/generate.ts",
    "build": "bun run generate && bun src/build.ts",
    "pretypecheck": "bun run generate",
    "typecheck": "tsc --noEmit",
    "prelint": "bun run generate",
    "lint": "eslint .",
    "format": "prettier --check .",
    "pretest": "bun run build",
    "test": "bun test",
    "test:coverage": "bun run generate && bun test --coverage",
    "preknip": "bun run generate",
    "knip": "knip",
    "licenses": "license-checker-rseidelsohn --production --excludePrivatePackages --onlyAllow \"MIT;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;(BSD-3-Clause AND Apache-2.0)\"",
    "cspell": "cspell lint --no-progress .",
    "lint:css": "stylelint 'Resources/*.css'",
    "lint:html": "html-validate 'Resources/*.html'"
  },
  "dependencies": {
    "@openbunny/theme": "file:../openbunny-theme/packages/web",
    "material-icon-theme": "5.38.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.4.0",
    "cspell": "10.1.1",
    "esbuild": "0.27.2",
    "eslint": "9.39.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.2.0",
    "eslint-plugin-security": "4.0.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.11.0",
    "html-validate": "11.15.0",
    "jsdom": "30.0.1",
    "knip": "6.33.0",
    "license-checker-rseidelsohn": "5.0.1",
    "prettier": "3.9.6",
    "stylelint": "17.15.0",
    "stylelint-config-standard": "40.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
