{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en-GB",
  "ignorePaths": [
    "**/*.png",
    "**/*.svg",
    "**/node_modules/**",
    "**/coverage/**",
    "**/DerivedData/**",
    "build/**",
    "bun.lock",
    "mise.lock",
    "Resources/content/**",
    "Resources/generated/**",
    "Resources/options.js",
    "Resources/popup.js",
    "src/generated/**",
    "*.xcodeproj/**",
    "tests/fixtures/**",
    ".git/**"
  ],
  "ignoreRegExpList": [
    "/#[0-9a-fA-F]{3,8}/",
    "/#[0-9a-fA-F]{3,8}\\b/g",
    "/[0-9a-f]{7,40}/",
    "/\\boklch\\([^)]*\\)/g",
    "/oklch\\([^)]*\\)/",
    "/xargs grep -niE \"[^\"]*\"/"
  ],
  "dictionaries": [
    "typescript",
    "node",
    "css",
    "html",
    "softwareTerms",
    "filetypes",
    "companies",
    "bash",
    "npm",
    "fonts",
    "misc",
    "fullstack"
  ],
  "words": [
    "appex",
    "appiconset",
    "codesign",
    "colorset",
    "hrefs",
    "magick",
    "rsvg",
    "appl",
    "archlinux",
    "assetcatalog",
    "basenames",
    "bunx",
    "cgit",
    "codeberg",
    "drupalcode",
    "forgejo",
    "framagit",
    "gitea",
    "gitee",
    "glyphmark",
    "iconfont",
    "infoplist",
    "justfiles",
    "nonisolated",
    "nosemgrep",
    "notarytool",
    "objc",
    "octicon",
    "openbunny",
    "pinact",
    "plists",
    "resizability",
    "rseidelsohn",
    "selftest",
    "sendable",
    "semgrep",
    "sourceforge",
    "swiftlint",
    "toolong",
    "torproject",
    "unknownext",
    "userdefaults",
    "vars",
    "vendored",
    "zizmor",
    "videolan",
    "xcassets",
    "xcconfig",
    "xcodegen",
    "xcodeproj",
    "spctl",
    "xcprivacy",
    "xcresult",
    "xcresulttool",
    "xcrun"
  ]
}
